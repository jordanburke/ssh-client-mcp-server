{
  "name": "ssh-client-mcp-server",
  "license": "MIT",
  "version": "1.5.1",
  "description": "MCP server that exposes SSH command execution to LLMs. Config parsing (functype), path expansion (~, $VAR), and OS-user fallback.",
  "author": "Jordan Burke <jordan.burke@gmail.com>",
  "homepage": "https://github.com/jordanburke/ssh-client-mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordanburke/ssh-client-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/jordanburke/ssh-client-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "ssh",
    "ssh2",
    "model-context-protocol",
    "claude",
    "anthropic",
    "llm",
    "remote-shell",
    "somamcp",
    "fastmcp",
    "functype",
    "typescript",
    "cli"
  ],
  "mcpName": "io.github.jordanburke/ssh-client-mcp-server",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "ssh-client-mcp-server": "dist/index.js"
  },
  "files": [
    "lib",
    "dist"
  ],
  "scripts": {
    "validate": "ts-builds validate",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "ts-builds lint",
    "lint:check": "ts-builds lint:check",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "test:ui": "ts-builds test:ui",
    "build": "ts-builds build",
    "dev": "ts-builds dev",
    "inspect": "pnpm build && npx @modelcontextprotocol/inspector dist/index.js",
    "check:versions": "tsx scripts/check-versions.ts",
    "prepublishOnly": "pnpm check:versions && pnpm validate"
  },
  "prettier": "ts-builds/prettier",
  "dependencies": {
    "@ssh-mcp/core": "workspace:*",
    "functype": "^1.16.0",
    "functype-os": "^1.16.0",
    "somamcp": "^1.4.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ssh2": "^1.15.6",
    "ts-builds": "^4.0.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.15"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
